# Local development (outside Docker): copy to apps/backend/.env
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://specto:change-me@localhost:5432/specto_db?schema=public
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000

JWT_SECRET=generate-a-long-random-string
OPENAI_API_KEY=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=screenshots
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-too
MINIO_PUBLIC_URL=http://localhost:9000

# Optional: OAuth providers and notifications
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
RESEND_API_KEY=

# Re-run a test automatically after AI healing (true/false)
AUTO_RERUN_AFTER_HEALING=false
