{
  "server": "http://localhost:4000",
  "apiKey": "${SPECTO_API_KEY}",
  "project": "your-project-id-here",
  "environments": {
    "staging": {
      "baseUrl": "https://staging.example.com",
      "variables": {
        "API_URL": "https://api.staging.example.com",
        "DB_NAME": "staging_db"
      }
    },
    "production": {
      "baseUrl": "https://example.com",
      "variables": {
        "API_URL": "https://api.example.com",
        "DB_NAME": "prod_db"
      }
    }
  },
  "tests": {
    "e2e": [
      "test-id-1",
      "test-id-2"
    ],
    "api": [
      "api-test-id-1",
      "api-test-id-2"
    ]
  },
  "options": {
    "parallel": 3,
    "timeout": 30000,
    "retries": 2,
    "bail": false
  }
}
