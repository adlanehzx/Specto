# Copy to .env and adjust before running `docker compose up -d`

# --- Ports exposed on the host ---
FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- PostgreSQL ---
POSTGRES_USER=specto
POSTGRES_PASSWORD=change-me
POSTGRES_DB=specto_db

# --- Redis (BullMQ queue) ---
REDIS_PASSWORD=change-me

# --- MinIO (S3-compatible storage for screenshots and reports) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
MINIO_PUBLIC_URL=http://localhost:9000

# --- Backend ---
JWT_SECRET=generate-a-long-random-string
OPENAI_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
